# The complete list of backend variables (provider keys, database, jobs, watchlist, pipeline) is in the ROOT .env.example.
# The backend reads variables from the process environment (Docker Compose passes the root .env).

# Optional: absolute path to a local FinBERT model directory.
# Defaults to backend/models/finbert
# FINBERT_MODEL_PATH=C:/models/finbert

# Comma-separated origins for a separately hosted frontend.
# CORS_ORIGINS=http://localhost:5173
