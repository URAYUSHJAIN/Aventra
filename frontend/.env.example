# Local development uses Vite's /api proxy defined in vite.config.ts.
# Set this only when the Flask API is hosted on a different origin (e.g. a Vercel frontend + separate backend).
# VITE_API_BASE_URL=https://api.example.com

# Dev-server only (not a VITE_ variable): proxy target when port 5000 is used by something else.
# AVENTRA_API_PROXY=http://127.0.0.1:5001

# Optional contact destination. When omitted, the contact form explains that
# message delivery has not been configured instead of silently discarding input.
# VITE_CONTACT_EMAIL=team@example.com
