# Copy to .env (never commit .env). All values are optional; defaults are shown.

# --- Docker Compose ---
# FRONTEND_PORT=8080          # http://localhost:8080
# BACKEND_PORT=5050           # direct API access (the UI goes through nginx)
# FINBERT_HOST_PATH=./backend/models/finbert   # host folder with config.json + pytorch_model.bin

# --- Backend / ML pipeline (also read when running `py -3.12 -m backend.app` locally) ---
# AVENTRA_DATA_MODE=live      # live = Yahoo Finance chart + Google News RSS (with stored fallback); demo = only data/demo (offline)
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# FINBERT_MODEL_PATH=backend/models/finbert
# AVENTRA_DB_PATH=data/aventra.sqlite3
# AVENTRA_ARTIFACT_DIR=artifacts
# AVENTRA_HISTORY_RANGE=5y
# AVENTRA_ANOMALY_THRESHOLD=0.65   # uncalibrated default
# AVENTRA_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# PORT=5000                   # local Flask dev server port
# FLASK_DEBUG=1

# No API keys are required: the current providers are keyless. If a keyed provider is added,
# put its key here (server-side only) — never in a VITE_* variable.
