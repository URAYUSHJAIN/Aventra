# Copy to .env and fill in what you need. Never commit .env. Keys are read server-side only — never put a key in a VITE_* variable.
# Docker Compose reads .env automatically. For local runs (py -3.12 -m backend.app) set the variables in your shell instead:
# the backend reads the process environment and does not load .env itself.

# --- Docker Compose ---------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=                # REQUIRED for `docker compose up` (choose any strong local password)
# POSTGRES_USER=aventra
# POSTGRES_DB=aventra
# FRONTEND_PORT=8080              # http://localhost:8080
# BACKEND_PORT=5050               # optional direct API access (the UI goes through nginx)
# FINBERT_HOST_PATH=./backend/models/finbert   # host folder with config.json + pytorch_model.bin (mounted read-only)

# --- Data provider credentials (all optional) ---------------------------------------------------------------------
# Without a key the provider reports PROVIDER_UNAVAILABLE and the UI shows "Data unavailable / insufficient source data".
# Keyless sources always on: Binance, CoinGecko (public tier), Frankfurter/ECB, AMFI + mfapi.in, SEC listing, Upstox instrument file.
# ALPHAVANTAGE_API_KEY=           # US/BSE equity & ETF daily history, symbol search, NEWS_SENTIMENT (the only news source)
# AVENTRA_ALPHAVANTAGE_DAILY_BUDGET=25   # free tier: 25 requests/day, 5/minute
# UPSTOX_ACCESS_TOKEN=            # NSE/BSE equity, ETF, index daily candles (tokens expire daily)
# FRED_API_KEY=                   # interest rates / yields, some commodity series (attribution shown in the UI)
# COINGECKO_DEMO_API_KEY=         # optional: higher CoinGecko limits
# OPENFIGI_API_KEY=               # optional: higher OpenFIGI limits for security-type refinement
# AVENTRA_SEC_USER_AGENT="Your Org your.name@your-domain"   # SEC fair access asks for a real contact in the User-Agent

# --- Database & jobs ----------------------------------------------------------------------------------------------
# AVENTRA_DATABASE_URL=postgresql+psycopg://aventra:<password>@localhost:5432/aventra   # set by docker-compose; unset = SQLite
# AVENTRA_DB_PATH=data/aventra.sqlite3        # SQLite file used when AVENTRA_DATABASE_URL is unset
# AVENTRA_JOB_MODE=inline         # inline = API process runs jobs in threads (local dev); external = separate worker (Docker); sync = run in-request (tests)
# AVENTRA_INLINE_JOB_THREADS=2
# AVENTRA_WORKER_POLL_SECONDS=5
# AVENTRA_DEFAULT_WATCHLIST=CRYPTO:BTC-USDT,CRYPTO:ETH-USDT,FX:USDINR,MF-IN:122639   # canonical IDs; home page + scheduled daily analysis

# --- Backend / ML pipeline ----------------------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# FINBERT_MODEL_PATH=backend/models/finbert
# AVENTRA_DATA_DIR=data
# AVENTRA_ARTIFACT_DIR=artifacts
# AVENTRA_ANOMALY_THRESHOLD=0.65  # uncalibrated default
# AVENTRA_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# PORT=5000                       # local Flask dev server port
# FLASK_DEBUG=1

# --- Tests only ---------------------------------------------------------------------------------------------------
# AVENTRA_ENABLE_SYNTHETIC_TEST_DATA=1   # enables the synthetic TEST:DEMO instrument. Automated tests set this themselves; never set it in production.
